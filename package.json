{
  "name": "spa-meta-tags",
  "version": "1.1.0",
  "description": "Open Graph, Twitter card and SEO meta tags for single-page apps (Vue, React, Svelte) without SSR. Link previews on WhatsApp, Facebook, X and LinkedIn.",
  "author": "Roméo AZAGBA <roazagba@gmail.com> (https://roazagba.me)",
  "license": "MIT",
  "homepage": "https://roazagba.github.io/spa-meta-tags/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roazagba/spa-meta-tags.git"
  },
  "bugs": {
    "url": "https://github.com/roazagba/spa-meta-tags/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run type-check && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "meta-tags",
    "meta",
    "seo",
    "spa",
    "single-page-application",
    "open-graph",
    "og",
    "og-tags",
    "twitter-card",
    "link-preview",
    "social-preview",
    "whatsapp",
    "facebook",
    "linkedin",
    "vue",
    "react",
    "svelte",
    "vite",
    "express",
    "connect",
    "middleware",
    "ssr",
    "prerender",
    "crawler",
    "json-ld",
    "structured-data",
    "ai",
    "llms-txt",
    "robots-txt",
    "geo"
  ]
}
